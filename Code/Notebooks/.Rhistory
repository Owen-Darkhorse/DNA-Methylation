## Box-cox Transformation
source("../R-scripts/IVT.R") ## INT mapps empirical quantiles to normal(0,1) quantiles
## Boxcox applies monotonic transform
BoxCox <- function(X, lambda) {
apply(X, MARGIN = 2, FUN = function(x) {
if (lambda == 0) {
log(x+1e-6)
} else {
(x^lambda - 1)/lambda
}
})
}
### Root Transform
root.X <- BoxCox(original.X, 0.5)
### Log Transform
log.X <- BoxCox(original.X, 0)
## IVT Transformation
ivt.X <- IVT(original.X, 0.5)
