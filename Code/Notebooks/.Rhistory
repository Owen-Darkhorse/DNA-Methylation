non_zero_demean <- function(X) {
## For each column, subtract mean value from nonzero values
## Keep zero values the same
apply(X, MARGIN = 2, FUN = function(x) {
non_zero_indx <- x > 0
non_zero_mean <- x[x > 0]
x[x > 0] = x[x > 0] - non_zero_mean
x
}, simplify = TRUE)
}
